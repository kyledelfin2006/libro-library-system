# Keep credentials, local databases, and source-control metadata out of every build stage.
.git/
.env
.env.*
data/
*.db
*.sqlite

# Exclude local build artifacts so Docker always compiles the current source in its build stage.
target/
out/
build/

# Exclude IDE and local-runner metadata that the Maven build does not need.
.idea/
.run/
.vscode/
.kilo/

# Exclude project documentation and examples that are not part of the executable application.
docs/
infra/
proposals/
assets/
README.md
AGENTS.md
issues.md
