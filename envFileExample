# Copy this file to `.env` in the repository root before running Docker Compose:
#   Copy-Item envFileExample .env   (PowerShell)
#   cp envFileExample .env          (macOS/Linux)
# Replace the example database credentials and provide a BCrypt hash and a
# random JWT signing key before first startup. Generate the key with:
#   openssl rand -base64 32
# Keep your populated `.env` private; do not commit it.
POSTGRES_DB=libraryDb
POSTGRES_USER=change_role
POSTGRES_PASSWORD=change_me
# Required ONLY for the first startup of an empty database: Flyway V2 uses it to create the initial administrator.
# Leave blank for databases where V2 is already applied. A fresh database with a blank value fails fast.
# Supply a BCrypt hash, never a plaintext password. No librarian is seeded.
LIBRO_ADMIN_PASSWORD_HASH=
# Required Base64 encoding of at least 32 cryptographically random bytes.
LIBRO_JWT_SECRET_BASE64=
# Optional; defaults match these values.
LIBRO_JWT_ISSUER=libro-api
LIBRO_JWT_AUDIENCE=libro-api
LIBRO_JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Comma-separated exact UI origins; blank denies browser cross-origin access by default.
LIBRO_CORS_ALLOWED_ORIGINS=
# Allowed values: none/native. Default none; use native only when the API port is reachable solely from the trusted proxy.
SERVER_FORWARD_HEADERS_STRATEGY=none
# Per-IP public route limits. Tune for expected traffic before internet exposure.
LIBRO_LOGIN_RATE_LIMIT_REQUESTS=20
LIBRO_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LIBRO_SIGNUP_RATE_LIMIT_REQUESTS=10
LIBRO_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
LIBRO_RATE_LIMIT_MAX_TRACKED_CLIENT_ROUTES=10000
# Optional 0000-0000 university ID; blank disables bootstrap and all four other values are required when set.
LIBRO_BOOTSTRAP_LIBRARIAN_UNIVERSITY_ID=
# Optional valid librarian email (max 150 chars); blank disables bootstrap and all four other values are required when set.
LIBRO_BOOTSTRAP_LIBRARIAN_EMAIL=
# Optional nonblank librarian first name (max 50 chars); blank disables bootstrap and all four other values are required when set.
LIBRO_BOOTSTRAP_LIBRARIAN_FIRST_NAME=
# Optional nonblank librarian last name (max 50 chars); blank disables bootstrap and all four other values are required when set.
LIBRO_BOOTSTRAP_LIBRARIAN_LAST_NAME=
# Optional BCrypt hash only (never plaintext); blank disables bootstrap and all four other values are required when set.
LIBRO_BOOTSTRAP_LIBRARIAN_PASSWORD_HASH=
# Serves /v3/api-docs and /swagger-ui.html without authentication. Default true; set false in production
# if the API contract should not be public.
LIBRO_API_DOCS_ENABLED=true
