# Environment template for Docker Compose. Copy it to `.env` in the repository root and fill the required values:
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
# Keep your populated `.env` private; it is ignored by git and by the Docker build context.
#
# How values reach the app: docker-compose.yml passes each variable below into the container only when it is set.
# A commented-out (unset) variable falls back to the default in src/main/resources/application.properties, which is
# the single place defaults live. Leaving a variable present but EMPTY (NAME=) passes an empty string, so comment
# optional lines out rather than blanking them.
#
# BCrypt hashes contain `$`. Wrap them in single quotes, e.g. NAME='$2a$10$...', so shells and scripts/common.sh
# do not expand them.

# ===== Required =======================================================================================================
POSTGRES_DB=libraryDb
POSTGRES_USER=change_role
POSTGRES_PASSWORD=change_me

# Base64 of at least 32 random bytes; signs and verifies JWTs. Generate with: openssl rand -base64 32
LIBRO_JWT_SECRET_BASE64=

# Required ONLY for the first startup of an EMPTY database: Flyway V2 uses this BCrypt hash to create the historical
# bootstrap administrator (0000-0001). Leave it blank once V2 has been applied. A blank value on an empty database
# makes the migration fail fast. Never put a plaintext password here. No librarian is seeded by migration.
LIBRO_ADMIN_PASSWORD_HASH=

# ===== Optional (defaults shown) ======================================================================================
# JWT claims and lifetime.
# LIBRO_JWT_ISSUER=libro-api
# LIBRO_JWT_AUDIENCE=libro-api
# LIBRO_JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Serves /v3/api-docs and /swagger-ui.html without authentication. Keep false except locally or on the
# synthetic-data public demo.
# LIBRO_API_DOCS_ENABLED=false

# Comma-separated exact browser UI origins, e.g. https://ui.example.edu. Unset allows no cross-origin requests;
# `*` is rejected at startup.
# LIBRO_CORS_ALLOWED_ORIGINS=

# none or native. Use native ONLY when the app port is reachable solely from the trusted proxy (the proxy profile and
# infra/docker-compose.prod.yml), so per-IP rate limits see real client addresses.
# SERVER_FORWARD_HEADERS_STRATEGY=none

# Per-IP limits for the public login and signup routes, per application instance. Tune before internet exposure.
# LIBRO_LOGIN_RATE_LIMIT_REQUESTS=20
# LIBRO_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# LIBRO_SIGNUP_RATE_LIMIT_REQUESTS=10
# LIBRO_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
# LIBRO_RATE_LIMIT_MAX_TRACKED_CLIENT_ROUTES=10000

# Hikari connection pool size per instance; keep below PostgreSQL max_connections divided by the instance count.
# LIBRO_DB_POOL_SIZE=10

# Log level for the application's own packages (DEBUG while investigating).
# LOGGING_LEVEL_APP=INFO

# Optional first-librarian provisioning at startup. Set ALL five together, or none. Repeat starts are idempotent.
#   UNIVERSITY_ID  0000-0000 format          EMAIL  valid, at most 150 characters
#   FIRST/LAST_NAME  at most 50 characters   PASSWORD_HASH  a BCrypt hash, never plaintext
# LIBRO_BOOTSTRAP_LIBRARIAN_UNIVERSITY_ID=
# LIBRO_BOOTSTRAP_LIBRARIAN_EMAIL=
# LIBRO_BOOTSTRAP_LIBRARIAN_FIRST_NAME=
# LIBRO_BOOTSTRAP_LIBRARIAN_LAST_NAME=
# LIBRO_BOOTSTRAP_LIBRARIAN_PASSWORD_HASH=

# ===== Proxy and production ===========================================================================================
# Public host name for the TLS proxy (`docker compose --profile proxy up`). Defaults to localhost locally;
# infra/docker-compose.prod.yml requires a real name.
# LIBRO_DOMAIN=localhost

# Production only (scripts/deploy.sh): mounted block-volume path and optional off-host backup bucket.
# See docs/devops/runbook.md.
# LIBRO_DATA_DIR=/mnt/libro
# LIBRO_BACKUP_BUCKET=
# Optional label returned by the staff-only /app/info endpoint.
# LIBRO_ENVIRONMENT_NAME=local
